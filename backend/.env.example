PC_DATABASE_URL=postgresql+psycopg://pc:pc@localhost:5432/policy_compass
PC_CORS_ORIGINS=["http://localhost:5173"]
# Base URL used in emailed links.
PC_PUBLIC_BASE_URL=http://localhost:5173
# Leave PC_SMTP_HOST empty in development: emails are printed in the API terminal instead.
# PC_SMTP_HOST=smtp.example.org
# PC_SMTP_USERNAME=
# PC_SMTP_PASSWORD=
# PC_EMAIL_FROM=Policy Compass <no-reply@example.org>
# Claude API key for grounded answers. Never commit the real key (.env is git-ignored).
ANTHROPIC_API_KEY=
